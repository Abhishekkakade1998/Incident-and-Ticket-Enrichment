# Copy to .env and replace every "replace-me". Never commit .env.
# ---------------------------------------------------------------- source systems
ALARM_API_BASE_URL=http://alarm-api:8000
ALARM_API_TOKEN=replace-me
TICKETING_API_URL=http://ticketing-api:8100
TICKETING_API_TOKEN=replace-me
# Optional: pin the simulator's "now" for reproducible demos (ISO-8601). Empty = current hour.
SIM_ANCHOR_TIME=

# ---------------------------------------------------------------- MCP servers (client -> server auth)
ALARM_MCP_URL=http://alarm-mcp:9001/mcp
ALARM_MCP_TOKEN=replace-me
TICKETING_MCP_URL=http://ticketing-mcp:9002/mcp
TICKETING_MCP_TOKEN=replace-me
SOURCE_TIMEOUT_S=8
SOURCE_MAX_RETRIES=2
TOOL_TIMEOUT_S=25
MCP_TOOL_TIMEOUT_S=30

# ---------------------------------------------------------------- write approval (shared by backend + ticketing MCP)
APPROVAL_SIGNING_KEY=replace-me-with-32-random-bytes
APPROVAL_TTL_S=600

# ---------------------------------------------------------------- RAG
DOCUMENT_PATH=./rag/documents
RAG_INDEX_PATH=./rag/index/index.json
RAG_AUTO_INGEST=true
RAG_TOP_K=5

# ---------------------------------------------------------------- LLM (offline = deterministic grounded composer, no external calls)
LLM_PROVIDER=offline
# LLM_PROVIDER=anthropic
LLM_API_KEY=replace-me
LLM_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- ops
LOG_LEVEL=INFO
AUDIT_DB_PATH=./data/audit.sqlite3
